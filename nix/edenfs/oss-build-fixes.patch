+use thrift_streaming_clients::StreamingEdenService;
+
+pub type Client = Arc<dyn StreamingEdenService + Send + Sync + 'static>;
+
+#[doc(hidden)]
+pub fn connect(path: &Path, conn_timeout_ms: u32, recv_timeout_ms: u32) -> Result<Client> {
+    let stream = std::os::unix::net::UnixStream::connect(path)
+        .with_context(|| format!("failed to connect to {}", path.display()))?;
+    if recv_timeout_ms > 0 {
+        stream.set_read_timeout(Some(Duration::from_millis(recv_timeout_ms.into())))?;
+    }
+    if conn_timeout_ms > 0 {
+        stream.set_write_timeout(Some(Duration::from_millis(conn_timeout_ms.into())))?;
+    }
+    stream.set_nonblocking(true)?;
+    let stream = tokio::net::UnixStream::from_std(stream)?;
+    let transport = SocketTransport::new_with_error_handler(stream, |error| {
+        tracing::error!(target: "transport_errors", thrift_transport_error = ?error)
+    });
+    Ok(<dyn StreamingEdenService>::new(CompactProtocol, transport))
+}
+
+#[macro_export]
+macro_rules! make_StreamingEdenServiceExt_thriftclient {
+    (
+        $fb:expr,
+        protocol = CompactProtocol,
+        from_path = $path:expr,
+        with_conn_timeout = $conn_timeout:expr,
+        with_recv_timeout = $recv_timeout:expr,
+        with_secure = false $(,)?
+    ) => {{
+        let _ = $fb;
+        $crate::connect(
+            ::std::path::Path::new($path),
+            $conn_timeout,
+            $recv_timeout,
+        )
+    }};
+}
