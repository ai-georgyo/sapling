+/*
+ * Copyright (c) Meta Platforms, Inc. and affiliates.
+ *
+ * This software may be used and distributed according to the terms of the
+ * GNU General Public License version 2.
+ */
+
+//! No-op telemetry for open source builds of the EdenFS CLI.
+
+/// A telemetry sample. Fields are accepted and discarded.
+#[derive(Debug, Default, Clone, serde::Serialize)]
+pub struct EdenSample;
+
+impl EdenSample {
+    pub fn new() -> Self {
+        Self
+    }
+
+    pub fn add_string(&mut self, _key: &str, _value: impl AsRef<str>) {}
+
+    pub fn add_int(&mut self, _key: &str, _value: impl Into<i64>) {}
+
+    pub fn add_bool(&mut self, _key: &str, _value: bool) {}
+
+    pub fn add_string_list(&mut self, _key: &str, _value: impl IntoIterator<Item = impl AsRef<str>>) {}
+
+    pub fn fail(&mut self, _error: &str) {}
+}
+
+/// Something samples can be logged to.
+pub trait SampleLogger {
+    fn log(&self, sample: EdenSample) -> anyhow::Result<()>;
+}
+
+/// The logger returned by [`create_logger`]; discards everything.
+#[derive(Debug, Default)]
+pub struct NullLogger;
+
+impl SampleLogger for NullLogger {
+    fn log(&self, _sample: EdenSample) -> anyhow::Result<()> {
+        Ok(())
+    }
+}
+
+pub fn create_logger(_dataset: String) -> NullLogger {
+    NullLogger
+}
+
+/// Logger that would batch samples before sending them; discards everything.
+#[derive(Debug, Default)]
+pub struct QueueingScubaLogger;
+
+impl QueueingScubaLogger {
+    pub fn new(_logger: NullLogger, _capacity: usize) -> Self {
+        Self
+    }
+}
+
+impl SampleLogger for QueueingScubaLogger {
+    fn log(&self, _sample: EdenSample) -> anyhow::Result<()> {
+        Ok(())
+    }
+}
+
+/// Maps system information keys to the column names of the EdenFS events
+/// dataset.
+pub fn edenfs_events_mapper(key: &str) -> Option<String> {
+    Some(key.to_string())
+}
+
+/// Adds host information to a sample (nothing in open source builds).
+pub fn collect_system_info(_sample: &mut EdenSample, _mapper: fn(&str) -> Option<String>) {}
+
+pub fn telemetry_disabled() -> bool {
+    true
+}
