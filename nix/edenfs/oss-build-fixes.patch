+# Bundles all Rust code linked into the EdenFS daemon into one static library.
+#
+# Each Rust staticlib carries its own copy of the Rust standard library and of
+# the `cxx` runtime (whose symbols are not mangled), so linking several of
+# them into one binary fails with duplicate symbols. Buck links Rust libraries
+# differently; for CMake, build a single staticlib instead.
+
+[package]
+name = "oss-rust-ffi"
+version = "0.1.0"
+edition = "2024"
+license = "GPLv2+"
+
+[lib]
+name = "edenfs_rust_ffi"
+path = "src/lib.rs"
+crate-type = ["staticlib"]
+
+[dependencies]
+backtrace-ffi = { version = "0.1.0", path = "../backtrace_ffi" }
+redirect-ffi = { version = "0.1.0", path = "../redirect_ffi" }
+sapling-backingstore = { version = "0.1.0", path = "../../../scm/lib/backingstore" }
+sapling-edenfs_ffi = { version = "0.1.0", path = "../../../scm/lib/edenfs_ffi" }
